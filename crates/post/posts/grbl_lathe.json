{
  "id": "grbl_lathe",
  "name": "grblHAL lathe",
  "description": "Millimetre grblHAL lathe dialect. No line numbers and no program number. Diameter mode is G7, the ZX plane is G18, and feed per minute is G94. Constant surface speed is G96 D max-rpm S metres per minute. Direct rpm is G97. The spindle is M3, M4 or M5. Tool change is T and M6. A manual tool change is expected. Arcs are I and K, I a radius. There is no home block. Comments are in parentheses. The program ends with M30. No rotary axis.",
  "units": "mm",
  "line_numbers": { "enabled": false, "start": 10, "step": 10, "prefix": "N" },
  "decimals": { "linear": 4, "feed": 3, "dwell": 3 },
  "trailing_zeros": false,
  "header": [
    "({program_name})",
    "G21",
    "G90"
  ],
  "footer": [],
  "modal_motion": true,
  "arcs": { "mode": "ijk", "max_sweep_deg": 360, "helix": true },
  "planes": true,
  "dwell": { "word": "P", "unit": "s" },
  "process": {
    "spindle": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "torch": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "laser": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "extruder": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "knife": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "other": { "on": ["M3 S{speed}"], "off": ["M5"] }
  },
  "tool_change": ["T{tool} M6"],
  "coolant": { "flood": ["M8"], "mist": ["M7"], "off": ["M9"] },
  "comments": { "style": "paren" },
  "program_end": ["M30"],
  "max_line_length": 256,
  "axis_letters": "XYZ",
  "lathe": {
    "diameter_mode": true,
    "mode_lines": ["G7"],
    "plane": "G18",
    "feed_mode": "G94",
    "css": ["G96 D{max_rpm} S{surface}"],
    "rpm": ["G97 S{rpm}"],
    "spindle_cw": ["M3"],
    "spindle_ccw": ["M4"],
    "spindle_off": ["M5"],
    "tool_change": ["T{tool} M6"],
    "arc_flip": false,
    "home": []
  }
}
