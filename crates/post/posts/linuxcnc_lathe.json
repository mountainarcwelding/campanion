{
  "id": "linuxcnc_lathe",
  "name": "LinuxCNC lathe",
  "description": "Millimetre LinuxCNC lathe dialect. Absolute moves, diameter mode (G7), ZX plane (G18) and feed per minute (G94). Constant surface speed is G96 D max-rpm S metres/min; direct rpm is G97. Tool change is T and M6, then G43. IJK arcs in the ZX plane. Single-point threading is G33 with the lead on K. The live tool is spindle 1 (M3, M4 and M5 with $1) and a C move uses inverse-time feed (G93). The C-axis switch and brake are left empty because LinuxCNC does them in HAL or a user M-code, and a custom post can fill them.",
  "references": [
    "M3/M4/M5 $n select spindle n (live tool = spindle 1): https://linuxcnc.org/docs/stable/html/gcode/m-code.html",
    "G93 inverse time feed: https://linuxcnc.org/docs/stable/html/gcode/g-code.html#gcode:g93-g94-g95",
    "C axis switching and brake are machine-specific (HAL / M100-M199 user M-codes): https://linuxcnc.org/docs/stable/html/gcode/m-code.html#mcode:m100-m199"
  ],
  "units": "mm",
  "line_numbers": { "enabled": true, "start": 10, "step": 10, "prefix": "N" },
  "decimals": { "linear": 4, "feed": 4, "dwell": 3 },
  "trailing_zeros": true,
  "header": [
    "({program_name})",
    "G21",
    "G90",
    "G40",
    "G49",
    "G64 P0.01"
  ],
  "footer": [],
  "modal_motion": true,
  "arcs": { "mode": "ijk", "max_sweep_deg": 360, "helix": true },
  "planes": true,
  "dwell": { "word": "P", "unit": "s" },
  "process": {
    "spindle": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "torch": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "laser": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "extruder": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "knife": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "other": { "on": ["M3 S{speed}"], "off": ["M5"] }
  },
  "tool_change": ["T{tool} M6"],
  "coolant": { "flood": ["M8"], "mist": ["M7"], "off": ["M9"] },
  "comments": { "style": "paren" },
  "program_end": ["M2"],
  "max_line_length": 256,
  "axis_letters": "XYZ",
  "lathe": {
    "diameter_mode": true,
    "mode_lines": ["G7"],
    "plane": "G18",
    "feed_mode": "G94",
    "css": ["G96 D{max_rpm} S{surface}"],
    "rpm": ["G97 S{rpm}"],
    "spindle_cw": ["M3"],
    "spindle_ccw": ["M4"],
    "spindle_off": ["M5"],
    "tool_change": ["T{tool} M6", "G43"],
    "arc_flip": false,
    "home": ["G53 G0 X0 Z0"],
    "thread": { "code": "G33", "lead_word": "K" },
    "c_axis": { "letter": "C", "engage": [], "disengage": [] },
    "brake": { "clamp": [], "release": [] },
    "live_tool": { "forward": ["S{rpm} $1", "M3 $1"], "reverse": ["S{rpm} $1", "M4 $1"], "stop": ["M5 $1"], "feed_mode": "" },
    "y_axis": { "letter": "Y", "face_plane": "G17", "side_plane": "G19", "turn_plane": "G18" },
    "c_feed": "inverse_time"
  }
}
