{
  "id": "fanuc",
  "name": "Fanuc",
  "description": "Millimetre Fanuc mill dialect. Percent-delimited program O0001, sequence numbers, one safe block, R arcs of at most 180 degrees, helices as lines, dwell P in milliseconds. A axis with inverse-time feed (G93, cancelled by G94) when the angle changes.",
  "program_number": "0001",
  "units": "mm",
  "line_numbers": { "enabled": true, "start": 10, "step": 10, "prefix": "N" },
  "decimals": { "linear": 3, "feed": 3, "dwell": 3 },
  "trailing_zeros": false,
  "decimal_point": true,
  "header": [
    "%",
    "O{program_number}",
    "({program_name})",
    "G21 G90 G17 G40 G49 G80"
  ],
  "footer": [],
  "modal_motion": true,
  "arcs": { "mode": "r", "max_sweep_deg": 180, "helix": false },
  "planes": true,
  "dwell": { "word": "P", "unit": "ms" },
  "process": {
    "spindle": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "torch": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "laser": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "extruder": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "knife": { "on": ["M3 S{speed}"], "off": ["M5"] },
    "other": { "on": ["M3 S{speed}"], "off": ["M5"] }
  },
  "tool_change": ["T{tool} M6", "G43 H{tool}"],
  "coolant": { "flood": ["M8"], "mist": ["M7"], "off": ["M9"] },
  "comments": { "style": "paren" },
  "program_end": ["M30", "%"],
  "max_line_length": 80,
  "axis_letters": "XYZ",
  "rotary": {
    "axes": ["a"],
    "decimals": 3,
    "feed_mode": "inverse_time",
    "inverse_time_on": "G93",
    "inverse_time_off": "G94"
  }
}
