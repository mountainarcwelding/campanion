{
  "id": "waterjet",
  "name": "LinuxCNC waterjet",
  "description": "LinuxCNC-style waterjet in millimetres. Absolute moves, cutter compensation and tool length cancelled, path blend G64 P0.05 as on the plasma post, not a measured setting. G41/G42 then G40 for controller compensation; computed stays on the offset path. Jet is Torch M3 S1 / M5. Named Other abrasive is M64 Pn / M65 Pn; digital_out.abrasive_pin defaults to 0, a post parameter, not a machine assignment. Other Other names are refused. Pierce delay is the path dwell (G4 P seconds). IJK arcs; helices as lines. thc words stay empty until a manual cites them. process_cycle is per_cut: abrasive then jet off before a rapid, jet then abrasive on before the next feed. A pierce dwell is written only when the IR has one. Optional continuous five-axis A/B when the program has kinematics: G93/G94, empty retract (none cited), chord_tol 0.005 and axis_tol_deg 0.1 as post parameters, not measured settings. Not proven on a machine.",
  "units": "mm",
  "line_numbers": {
    "enabled": true,
    "start": 10,
    "step": 10,
    "prefix": "N"
  },
  "decimals": {
    "linear": 4,
    "feed": 4,
    "dwell": 3
  },
  "trailing_zeros": true,
  "header": [
    "({program_name})",
    "G21",
    "G90",
    "G17",
    "G40",
    "G49",
    "G64 P0.05"
  ],
  "footer": [],
  "modal_motion": true,
  "arcs": {
    "mode": "ijk",
    "max_sweep_deg": 360,
    "helix": false
  },
  "planes": true,
  "dwell": {
    "word": "P",
    "unit": "s"
  },
  "thc": {
    "on": [],
    "off": []
  },
  "process_cycle": "per_cut",
  "process": {
    "spindle": {
      "on": [
        "M3 S{speed}"
      ],
      "off": [
        "M5"
      ]
    },
    "torch": {
      "on": [
        "M3 S1"
      ],
      "off": [
        "M5"
      ]
    },
    "laser": {
      "on": [
        "M3 S{speed}"
      ],
      "off": [
        "M5"
      ]
    },
    "extruder": {
      "on": [
        "M3 S{speed}"
      ],
      "off": [
        "M5"
      ]
    },
    "knife": {
      "on": [
        "M3 S{speed}"
      ],
      "off": [
        "M5"
      ]
    },
    "abrasive": {
      "on": [
        "M64 P{pin}"
      ],
      "off": [
        "M65 P{pin}"
      ]
    }
  },
  "auxiliaries": [
    "abrasive"
  ],
  "digital_out": {
    "abrasive_pin": 0
  },
  "tool_change": [
    "T{tool} M6"
  ],
  "cutter_comp": {
    "left": [
      "G41"
    ],
    "right": [
      "G42"
    ],
    "off": [
      "G40"
    ]
  },
  "coolant": {
    "flood": [
      "M8"
    ],
    "mist": [
      "M7"
    ],
    "off": [
      "M9"
    ]
  },
  "comments": {
    "style": "paren"
  },
  "program_end": [
    "M2"
  ],
  "max_line_length": 256,
  "axis_letters": "XYZ",
  "references": [
    "https://linuxcnc.org/docs/stable/html/gcode/m-code.html#mcode:m3-m5",
    "https://linuxcnc.org/docs/stable/html/gcode/m-code.html#mcode:m62-m65",
    "https://linuxcnc.org/docs/stable/html/gcode/g-code.html#gcode:g93-g94"
  ],
  "rotary": {
    "axes": [
      "a",
      "b"
    ],
    "decimals": 3,
    "feed_mode": "inverse_time",
    "inverse_time_on": "G93",
    "inverse_time_off": "G94"
  },
  "five_axis": {
    "mode": "machine",
    "decimals": 3,
    "retract": [],
    "index": [
      "G0 {rotaries}"
    ],
    "on": [],
    "off": [],
    "continuous": {
      "feed": "inverse_time",
      "inverse_time_on": "G93",
      "inverse_time_off": "G94",
      "chord_tol": 0.005,
      "axis_tol_deg": 0.1
    }
  }
}
